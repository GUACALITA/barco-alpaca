# Alpaca paper account — crear en alpaca.markets (gratis)
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Claude (el cerebro)
ANTHROPIC_API_KEY=sk-ant-...

# Configuracion
PORT=30850
CAPITAL_USD=100000
CLAUDE_CYCLE_MINUTES=15
MONITOR_INTERVAL_SECONDS=30
STOP_LOSS_PCT=-0.005
TAKE_PROFIT_PCT=0.015

# Base de datos — SOLO trades_alpaca.db, NUNCA trades.db
ALPACA_DB_PATH=/root/trading_agent_alpaca/trades_alpaca.db

# Servicios de inteligencia — configurar con tus propios endpoints
VFZ_URL=http://YOUR_SERVER:PORT
META_BRAIN_URL=http://YOUR_SERVER:PORT
S2_URL=http://YOUR_SERVER:PORT
S3_URL=http://YOUR_SERVER:PORT
