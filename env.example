# Alpaca paper account — crear en alpaca.markets (gratis)
ALPACA_API_KEY=PKxxxxxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Claude (el cerebro)
ANTHROPIC_API_KEY=sk-ant-...

# Configuración
PORT=30850
CAPITAL_USD=100000
CLAUDE_CYCLE_MINUTES=60
MONITOR_INTERVAL_SECONDS=30
STOP_LOSS_PCT=-0.15
TAKE_PROFIT_PCT=0.50

# Base de datos — SOLO trades_alpaca.db, NUNCA trades.db
ALPACA_DB_PATH=/root/trading_agent_alpaca/trades_alpaca.db

# Servicios inteligencia VPS (ya corriendo, no tocar)
VFZ_URL=http://localhost:30818
META_BRAIN_URL=http://localhost:30843
S2_URL=http://localhost:30841
S3_URL=http://localhost:30842
